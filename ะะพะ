-- ฟังก์ชันค้นหาผู้เล่นที่อยู่ใกล้ที่สุด
local function getClosestPlayer()
   local closest = nil
   local shortestDistance = math.huge
   local localPlayer = game.Players.LocalPlayer

   for _, player in pairs(game.Players:GetPlayers()) do
      if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
         local dist = (player.Character.HumanoidRootPart.Position - localPlayer.Character.HumanoidRootPart.Position).Magnitude
         if dist < shortestDistance then
            shortestDistance = dist
            closest = player
         end
      end
   end
   return closest
end

-- ระบบปรับแก้ทิศทางการยิงให้กระสุนพุ่งหาเป้าหมายอัตโนมัติ (Gun Lock Hook)
local gmt = getrawmetatable(game)
setreadonly(gmt, false)
local oldNamecall = gmt.__namecall

gmt.__namecall = newcclosure(function(self, ...)
   local method = getnamecallmethod()
   if gunLockEnabled and (method == "FindPartOnWithIgnoreList" or method == "Raycast") then
      local target = getClosestPlayer()
      if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
         return target.Character.HumanoidRootPart, target.Character.HumanoidRootPart.Position
      end
   end
   return oldNamecall(self, ...)
end)

-- Main Loop
game:GetService("RunService").RenderStepped:Connect(function()
   -- อัปเดตความเร็ว
   if speedEnabled then
      local char = game.Players.LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
         char.Humanoid.WalkSpeed = customWalkSpeed
      end
   end

   local target = getClosestPlayer()
   
   -- 4. ล็อคหัว (หมุนมุมกล้อง)
   if headLockEnabled and target and target.Character and target.Character:FindFirstChild("Head") then
      workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, target.Character.Head.Position)
   end

   -- 5. ขยายขนาดตัวผู้เล่นอื่น (Hitbox Expander)
   for _, player in pairs(game.Players:GetPlayers()) do
      if player ~= game.Players.LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
         local hrp = player.Character.HumanoidRootPart
         if hitBoxEnabled then
            hrp.Size = Vector3.new(hitBoxSize, hitBoxSize, hitBoxSize)
            hrp.Transparency = 0.7
            hrp.BrickColor = BrickColor.new("Really red")
            hrp.Material = Enum.Material.Neon
            hrp.CanCollide = false
         else
            hrp.Size = Vector3.new(2, 2, 1)
            hrp.Transparency = 1
         end
      end
   end
end)
