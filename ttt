-- Variables
local autoFish = false
local fullBar = false
local infOxygen = false

-- 1. ตกปลาอัตโนมัติ (1 วินาทีเสร็จสิ้น / Auto Reel & Shake)
TabMain:CreateToggle({
   Name = "1. ตกปลาอัตโนมัติ (Auto Fish 1 Sec)",
   CurrentValue = false,
   Callback = function(Value)
      autoFish = Value
      task.spawn(function()
         while autoFish do
            task.wait(0.5)
            local player = game.Players.LocalPlayer
            local char = player.Character
            if char then
               -- ดึงเบ็ดมาถือถ้ายังไม่ได้ถือ
               local rod = char:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
               if rod and rod:FindFirstChild("events") then
                  if rod.Parent == player.Backpack then
                     char.Humanoid:EquipTool(rod)
                  end
                  -- เหวี่ยงเบ็ดอัตโนมัติ
                  if rod.events:FindFirstChild("cast") then
                     rod.events.cast:FireServer(100)
                  end
               end
            end
            -- ลูปกด Shake และ ดึงเบ็ด (Reel)
            task.wait(0.5)
            if autoFish then
               local gui = player.PlayerGui
               -- Auto Shake
               if gui:FindFirstChild("shakeui") and gui.shakeui:FindFirstChild("safezone") then
                  local btn = gui.shakeui.safezone:FindFirstChild("button")
                  if btn then
                     gui.shakeui.safezone.button.Size = UDim2.new(10, 0, 10, 0)
                  end
               end
               -- Auto Reel Instant
               local reeler = gui:FindFirstChild("reel")
               if reeler and reeler:FindFirstChild("bar") then
                  local remote = game:GetService("ReplicatedStorage"):FindFirstChild("events")
                  if remote and remote:FindFirstChild("reelfinished") then
                     remote.reelfinished:FireServer(100, true)
                  end
               end
            end
         end
      end)
   end,
})

-- 3. หลอดการจับปลาเต็มหลอด (Max Fishing Bar / Perfect Catch)
TabMain:CreateToggle({
   Name = "3. หลอดจับปลาเต็มหลอด (Full Bar / Perfect)",
   CurrentValue = false,
   Callback = function(Value)
      fullBar = Value
   end,
})

-- Loop บังคับให้ขนาดหลอดจับปลาเต็มหลอดตลอดเวลา
game:GetService("RunService").RenderStepped:Connect(function()
   if fullBar then
      local player = game.Players.LocalPlayer
      local reeler = player.PlayerGui:FindFirstChild("reel")
      if reeler and reeler:FindFirstChild("bar") then
         local playerbar = reeler.bar:FindFirstChild("playerbar")
         if playerbar then
            playerbar.Size = UDim2.new(1, 0, 1, 0) -- ขยายหลอดเข็มเต็ม 100%
         end
      end
   end
end)

-- 4. ออกซิเจนไม่มีวันหมด (Infinite Oxygen)
TabMain:CreateToggle({
   Name = "4. ออกซิเจนไม่มีวันหมด (Infinite Oxygen)",
   CurrentValue = false,
   Callback = function(Value)
      infOxygen = Value
      task.spawn(function()
         while infOxygen do
            task.wait(0.5)
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("Oxygen") then
               char.Oxygen.Value = 100
            end
            -- ป้องกันหลอดดำน้ำลดลงในระบบ PlayerGui
            local clientData = game.Players.LocalPlayer:FindFirstChild("Character")
            if clientData and clientData:FindFirstChild("BodyGui") and clientData.BodyGui:FindFirstChild("Oxygen") then
               clientData.BodyGui.Oxygen.Value = 100
            end
         end
      end)
   end,
})

